generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id         String    @db.Uuid
  question           String
  student_name       String?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  ai_category        String?
  ai_relevance_score Int?
  ai_reason          String?
  ai_draft_answer    String?
  is_processed       Boolean?  @default(false)
  processed_at       DateTime? @db.Timestamptz(6)
  sessions           sessions  @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ai_category], map: "idx_questions_ai_category")
  @@index([created_at(sort: Desc)], map: "idx_questions_created_at")
  @@index([is_processed], map: "idx_questions_is_processed")
  @@index([session_id], map: "idx_questions_session_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String
  topic         String?
  description   String?
  unique_code   String      @unique
  instructor_id String      @default(dbgenerated("(auth.jwt() ->> 'sub'::text)"))
  is_active     Boolean?    @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  questions     questions[]

  @@index([instructor_id], map: "idx_sessions_instructor_id")
  @@index([unique_code], map: "idx_sessions_unique_code")
}
